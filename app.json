{
  "name": "Dropzones",
  "slug": "Dropzones",
  "scheme": "dropzones",
  "description": "USPA Dropzone Finder",
  "orientation": "portrait",
  "icon": "./assets/images/icon-light.png",
  "userInterfaceStyle": "automatic",
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": ["**/*"],
  "android": {
    "package": "io.otgapps.dropzones",
    "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
    "allowBackup": false,
    "config": {
      "googleMaps": {
        "apiKey": "AIzaSyDRsjdrHQu1hxIInW6yH2k34Jfrn80hcsU"
      }
    },
    "adaptiveIcon": {
      "backgroundImage": "./assets/images/splash-light.png",
      "foregroundImage": "./assets/images/icon-bg-light.png"
    }
  },
  "ios": {
    "icon": {
      "dark": "./assets/images/icon-dark.png",
      "light": "./assets/images/icon-light.png"
    },
    "supportsTablet": true,
    "bundleIdentifier": "io.otgapps.dropzones",
    "infoPlist": {
      "NSLocationWhenInUseUsageDescription": "We use your location to find your closest USPA member dropzone.",
      "ITSAppUsesNonExemptEncryption": false
    },
    "appleTeamId": "DW9QQZR4ZL"
  },
  "web": {
    "favicon": "./assets/images/favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-sqlite",
    "expo-localization",
    "expo-font",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-light.png",
        "imageWidth": 300,
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "android": {
          "backgroundColor": "#1a73e8",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#000000"
          }
        }
      }
    ],

    "expo-build-properties"
  ],
  "buildCacheProvider": {
    "plugin": "expo-build-disk-cache"
  },
  "experiments": {
    "tsconfigPaths": true
  },
  "extra": {
    "eas": {
      "projectId": "9ef197d8-34eb-4d05-90aa-a8f0fb7bea3c"
    }
  }
}
